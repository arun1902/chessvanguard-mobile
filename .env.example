# Android emulator → host machine
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# iOS simulator / web (example)
# EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Physical device on same LAN (example)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1

# Support WhatsApp number with country code, digits only (example: 9198XXXXXXXX)
# EXPO_PUBLIC_SUPPORT_WHATSAPP=919876543210

# Zoho Payments (required for in-app demo booking + refill checkout)
# Use the same values as chessvanguard_v2 VITE_ZOHO_* locally
EXPO_PUBLIC_ZOHO_ACCOUNT_ID=
EXPO_PUBLIC_ZOHO_DOMAIN=IN
EXPO_PUBLIC_ZOHO_API_KEY=
# false = live widget (matches current web staging). true needs sandbox credentials.
EXPO_PUBLIC_ZOHO_TEST_MODE=false
